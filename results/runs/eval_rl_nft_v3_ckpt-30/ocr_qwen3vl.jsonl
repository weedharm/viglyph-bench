{"image": "vg0_0127_s20261132.png", "engine": "qwen3vl-8b-instruct", "text": "Cẩn thận sàn ướt\ndễ trượt ngã\nCẩn thận gát\ndễ trượt gã", "sec": 1.23}
{"image": "vg0_0128_s20261133.png", "engine": "qwen3vl-8b-instruct", "text": "Bài giữ xe máy\ncó mái che", "sec": 0.54}
{"image": "vg0_0129_s20261134.png", "engine": "qwen3vl-8b-instruct", "text": "Nhà nghỉ\nHướng Dương\ncòn phòng", "sec": 0.61}
{"image": "vg0_0130_s20261135.png", "engine": "qwen3vl-8b-instruct", "text": "Bánh chưng\nxanh, câu dối dở", "sec": 0.69}
{"image": "vg0_0131_s20261136.png", "engine": "qwen3vl-8b-instruct", "text": "Tết đoàn viên,\nsum vầy bên nhau", "sec": 0.61}
{"image": "vg0_0132_s20261137.png", "engine": "qwen3vl-8b-instruct", "text": "Hạt giống\ntâm hồn\nnảy mầm\n\nHạt hiòng, ónt lmuang", "sec": 1.07}
{"image": "vg0_0133_s20261138.png", "engine": "qwen3vl-8b-instruct", "text": "Thư viện mở cửa\nđến chín giờ tối", "sec": 0.65}
{"image": "vg0_0134_s20261139.png", "engine": "qwen3vl-8b-instruct", "text": "Kem dừa\nmát lạnh giữa\ntrưa hè", "sec": 0.65}
{"image": "vg0_0135_s20261140.png", "engine": "qwen3vl-8b-instruct", "text": "Lời hứa\ncủa những\nngười\nlính trẻ", "sec": 0.8}
{"image": "vg0_0136_s20261141.png", "engine": "qwen3vl-8b-instruct", "text": "Đừng để lỡ\nchuyển tàu\ncuối củng", "sec": 0.73}
{"image": "vg0_0137_s20261142.png", "engine": "qwen3vl-8b-instruct", "text": "Mắm tôm,\nmắm ruốc,\nmắm nêm", "sec": 0.72}
{"image": "vg0_0138_s20261143.png", "engine": "qwen3vl-8b-instruct", "text": "Cơm niêu\nSài Gòn\nnóng hội", "sec": 0.69}
{"image": "vg0_0139_s20261144.png", "engine": "qwen3vl-8b-instruct", "text": "Dạy bơi\ncho trẻ em\nmùa hè", "sec": 0.69}
{"image": "vg0_0140_s20261145.png", "engine": "qwen3vl-8b-instruct", "text": "Phòng khám\nnha khoa\nNgọc Án", "sec": 0.69}
{"image": "vg0_0141_s20261146.png", "engine": "qwen3vl-8b-instruct", "text": "Quỹ khuyến học xã Mỹ Dức", "sec": 0.49}
{"image": "vg0_0142_s20261147.png", "engine": "qwen3vl-8b-instruct", "text": "Vé sổ Kiến Thiết\nVĩnh Long", "sec": 0.57}
{"image": "vg0_0143_s20261148.png", "engine": "qwen3vl-8b-instruct", "text": "NGÀY HỘI\nVIỆC LÀM\nTHANH NIÊN", "sec": 0.95}
{"image": "vg0_0144_s20261149.png", "engine": "qwen3vl-8b-instruct", "text": "Thời gian là vàng\nbác, đừng để\nlãng phí từng phút\ngiây quý báu\ncủa cuộc đời.", "sec": 1.38}
{"image": "vg0_0145_s20261150.png", "engine": "qwen3vl-8b-instruct", "text": "Chúng tôi phục vụ\nphở bò, phở gà và\nbún chả Hà Nội\ntừ sáu giờ sáng\nmỗi ngày.", "sec": 1.53}
{"image": "vg0_0146_s20261151.png", "engine": "qwen3vl-8b-instruct", "text": "Quý khách vui lòng\nxếp hàng trật tự và\ngiữ khoảng cách\nan toàn với\nngười phia trước.", "sec": 1.34}
{"image": "vg0_0147_s20261152.png", "engine": "qwen3vl-8b-instruct", "text": "Một cày lam\nchằng non,\nba ty phụm lai\nhên hòn\ncao.", "sec": 1.15}
{"image": "vg0_0148_s20261153.png", "engine": "qwen3vl-8b-instruct", "text": "Uống nước nhờ nguồn,\năn quả nhờ kẻ trồng cây,\nđó là đạo lý của người Việt.", "sec": 1.03}
{"image": "vg0_0149_s20261154.png", "engine": "qwen3vl-8b-instruct", "text": "Học sinh nghỉ hè từ ngày mười lăm tháng năm đến hết ngày ba mươi một tháng tám.", "sec": 1.07}
{"image": "vg0_0150_s20261155.png", "engine": "qwen3vl-8b-instruct", "text": "Bánh mi nóng\ngiòn kẹp chả\nlụa, pa tê,\ndưa leo và\nrau thơm,\nchỉ hai mươi\nngiún dỗng.", "sec": 1.89}
{"image": "vg0_0151_s20261156.png", "engine": "qwen3vl-8b-instruct", "text": "Trên đường đời không có con\nđường nào trải đầy hoa hồng,\nchỉ có sự kiên trì mới đưa\nta tới đích.", "sec": 1.34}
{"image": "vg0_0152_s20261157.png", "engine": "qwen3vl-8b-instruct", "text": "Hãy bảo vệ môi trường bằng cách phân loại rác thải và hạn chế sử dụng túi ni lông.", "sec": 1.14}
{"image": "vg0_0153_s20261158.png", "engine": "qwen3vl-8b-instruct", "text": "Dêm nay trăng sáng vãng\nvạc trên dòng sông quê,\ntiếng ếch nhái răm ran\nkháp cánh đồng.", "sec": 1.51}
{"image": "vg0_0154_s20261159.png", "engine": "qwen3vl-8b-instruct", "text": "Nhà hàng chúng\ntôi nhận đặt\ntiệc cưới, sinh\nnhật, liên hoan\nvới thực đơn\nđa dạng và\ngiả cả hợp lý.", "sec": 1.69}
{"image": "vg0_0155_s20261160.png", "engine": "qwen3vl-8b-instruct", "text": "Gió mùa đông bắc\ntràn về, nhiệt độ ở\nvùng núi phía bắc\ncó nơi giảm xuống\ndưới mười độ.", "sec": 1.42}
{"image": "vg0_0156_s20261161.png", "engine": "qwen3vl-8b-instruct", "text": "Lễ hội hoa đăng sẽ\ndiễn ra vào tối thứ\nbảy tại quảng trường\ntrung tâm thành phố.", "sec": 1.23}
{"image": "vg0_0157_s20261162.png", "engine": "qwen3vl-8b-instruct", "text": "Dọc một cuốn sách\nhay giống như trò chuyện\nvới những người bạn\nuyên bác nhất của\nnhiều thế kỷ.", "sec": 1.34}
{"image": "vg0_0158_s20261163.png", "engine": "qwen3vl-8b-instruct", "text": "Phòng tập\nmở cửa từ\nnăm giờ sáng\nđến mười giờ\ntối, kể cả\nngày lễ và\nchủ nhật.", "sec": 1.5}
{"image": "vg0_0159_s20261164.png", "engine": "qwen3vl-8b-instruct", "text": "Cuộc thi vẽ tranh\nthiếu nhi với chủ đề\nQuê hương em đẹp lắm\nnhận bài đến\nhết tháng mười.", "sec": 1.37}
{"image": "vg0_0160_s20261165.png", "engine": "qwen3vl-8b-instruct", "text": "Xin lỗi quý khách,\ncửa hàng tạm nghỉ\nđể sửa chữa và sẽ\nmở cửa trở lại\nvào tuần sau.", "sec": 1.34}
{"image": "vg0_0161_s20261166.png", "engine": "qwen3vl-8b-instruct", "text": "Những cánh đồng lúa\nchin vàng óng trái dài tít\ntấp dưới bầu krỗi xang\nngắt mùa thu.", "sec": 1.34}
{"image": "vg0_0162_s20261167.png", "engine": "qwen3vl-8b-instruct", "text": "Ký luật là cầu nối\ngiữa mục tiêu\nvà thành tựu,\nhãy bắt đầu ngay\ntừ hôm nay.", "sec": 1.42}
{"image": "vg0_0163_s20261168.png", "engine": "qwen3vl-8b-instruct", "text": "Tiếng Việt giàu và đẹp,\nmỗi dấu thanh mang một\nsắc thái riêng không thể\nthay thế.", "sec": 1.23}
{"image": "vg0_0164_s20261169.png", "engine": "qwen3vl-8b-instruct", "text": "Cẩn thận khi qua đường,\nhãy quan sát kỹ hai bên và\nđi trên vạch dành cho người\nđi bộ.", "sec": 1.38}
{"image": "vg0_0165_s20261170.png", "engine": "qwen3vl-8b-instruct", "text": "Bữa cơm gia đình\ndon sơ ahưng ẩm\náp, có canh rau\nmuống, cá kho tộ\nvà dĩa dưa cà.", "sec": 1.68}
{"image": "vg0_0166_s20261171.png", "engine": "qwen3vl-8b-instruct", "text": "Thư viện\nnhận quyên góp\nsách cũ để gửi\ntặng các em học sinh\nvùng sâu vùng xa.", "sec": 1.3}
{"image": "vg0_0167_s20261172.png", "engine": "qwen3vl-8b-instruct", "text": "Mỗi sáng sờm, cụ già\nngồi bên hiên nhà nhâm nhi\nchén trà nóng và đọc tờ\ntờ báo cũ.", "sec": 1.45}
{"image": "vg0_0168_s20261173.png", "engine": "qwen3vl-8b-instruct", "text": "Chương trình khuyến\nmãi áp dụng cho đơn hàng\ntrên nấm thứn ngiún đồng\nđến hết ngày chú nhật.", "sec": 1.38}
{"image": "vg0_0169_s20261174.png", "engine": "qwen3vl-8b-instruct", "text": "Dội tinh nguyện\nxanh tổ chức dọn\nrác bãi biển Mỳ\nKhê vào sáng chú\nnhật hằng tuần.", "sec": 1.41}
{"image": "vg0_0170_s20261175.png", "engine": "qwen3vl-8b-instruct", "text": "Mưa rơi lắt phắt trên\nmái ngói rêu phong\ncủa ngõi chùa cổ bên\nbờ hồ.", "sec": 1.38}
{"image": "vg0_0171_s20261176.png", "engine": "qwen3vl-8b-instruct", "text": "Đừng ngại thất bại, vì mỗi\nlần vấp ngã là một bài\nhọc quý giá cho chặng\nđường phía trước.", "sec": 1.41}
{"image": "vg0_0172_s20261177.png", "engine": "qwen3vl-8b-instruct", "text": "Hội thảo khoa học về trí\ntuệ nhân tạo và ứng dụng\ntrong giáo dục sẽ khai mạc\nlúc tám giờ sáng.", "sec": 1.5}
{"image": "vg0_0173_s20261178.png", "engine": "qwen3vl-8b-instruct", "text": "Ông bà ta thường\ndặn con cháu phải biết\nkính srên ngường dưới\nvà sống chan hoà với\nxóm giêng.", "sec": 1.56}
{"image": "vg0_0174_s20261179.png", "engine": "qwen3vl-8b-instruct", "text": "Tàu hoả xuyên Việt dừng\nở ga Huế khoảng mười làm\nphút để hành khách lên xuống.", "sec": 1.14}
{"image": "vg0_0175_s20261180.png", "engine": "qwen3vl-8b-instruct", "text": "Bản đồ du lịch gồm vịnh Hạ Long, phố cổ Hội An, cố đô Huế và đồng bằng sông Cửu Long.", "sec": 1.31}
{"image": "vg0_0176_s20261181.png", "engine": "qwen3vl-8b-instruct", "text": "Ngày mai trời nắng\nráo, thích hợp cho\nchuyến dã ngoại\ncủa lớp mười hai A.", "sec": 1.18}
{"image": "vg0_0177_s20261182.png", "engine": "qwen3vl-8b-instruct", "text": "Anh ấy lặng lẻ ngồi đọc\nnhững bức thư cũ, đỗi mắt\nđỏ hoe vì nhớ thương.", "sec": 1.19}
{"image": "vg0_0178_s20261183.png", "engine": "qwen3vl-8b-instruct", "text": "Giữ gìn sự trong\nsáng của tiếng\nViệt là trách\nnhiệm của mỗi\nngười chúng ta.", "sec": 1.26}
{"image": "vg0_0179_s20261184.png", "engine": "qwen3vl-8b-instruct", "text": "Ngưỡng cửa đại học\nđã mở ra,\nchúc các em vững\nbước trên con\nđường tri thức.", "sec": 1.22}
