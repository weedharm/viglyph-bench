{"image": "vg0_0124_s20261129.png", "engine": "vintern-1b-v3.5", "text": "Xưởng may\náo dãi truyền thống", "sec": 0.35}
{"image": "vg0_0125_s20261130.png", "engine": "vintern-1b-v3.5", "text": "Đồng hồ chính xác từng giây", "sec": 0.32}
{"image": "vg0_0126_s20261131.png", "engine": "vintern-1b-v3.5", "text": "Sửa chữa\ndiên thoại\nlấy liền", "sec": 0.41}
{"image": "vg0_0127_s20261132.png", "engine": "vintern-1b-v3.5", "text": "Cần thận sản ướt\ndễ trượt ngà", "sec": 0.47}
{"image": "vg0_0128_s20261133.png", "engine": "vintern-1b-v3.5", "text": "Bãi giữ xe máy\ncó mái che", "sec": 0.35}
{"image": "vg0_0129_s20261134.png", "engine": "vintern-1b-v3.5", "text": "Nhà nghỉ\nHướng Dương\ncòn phòng", "sec": 0.39}
{"image": "vg0_0130_s20261135.png", "engine": "vintern-1b-v3.5", "text": "Bánh chứng xanh, câu dối đỏ", "sec": 0.37}
{"image": "vg0_0131_s20261136.png", "engine": "vintern-1b-v3.5", "text": "Tết đoàn viên, sum vầy bên nhau", "sec": 0.39}
{"image": "vg0_0132_s20261137.png", "engine": "vintern-1b-v3.5", "text": "Hạt giống tâm hồn nầy mầm", "sec": 0.37}
{"image": "vg0_0133_s20261138.png", "engine": "vintern-1b-v3.5", "text": "Thư viện mở cửa\nđến chín giờ tối", "sec": 0.42}
{"image": "vg0_0134_s20261139.png", "engine": "vintern-1b-v3.5", "text": "Kem dừa\nmát lạnh giữa\ntrưa hè", "sec": 0.44}
{"image": "vg0_0135_s20261140.png", "engine": "vintern-1b-v3.5", "text": "Lời hứa của những người lính trẻ", "sec": 0.39}
{"image": "vg0_0136_s20261141.png", "engine": "vintern-1b-v3.5", "text": "Đừng đế lỡ chuyến tàu cuối cùng", "sec": 0.37}
{"image": "vg0_0137_s20261142.png", "engine": "vintern-1b-v3.5", "text": "Mắm tôm, mắm ruốc, mắm nêm", "sec": 0.46}
{"image": "vg0_0138_s20261143.png", "engine": "vintern-1b-v3.5", "text": "Cơm niêu\nSài Gòn\nnóng hội", "sec": 0.44}
{"image": "vg0_0139_s20261144.png", "engine": "vintern-1b-v3.5", "text": "Dạy bơi cho trẻ em mùa hè", "sec": 0.35}
{"image": "vg0_0140_s20261145.png", "engine": "vintern-1b-v3.5", "text": "Phòng khám nha khoa Ngọc Ấn", "sec": 0.35}
{"image": "vg0_0141_s20261146.png", "engine": "vintern-1b-v3.5", "text": "Quỹ khuyến học xã Mỹ Đức", "sec": 0.3}
{"image": "vg0_0142_s20261147.png", "engine": "vintern-1b-v3.5", "text": "Vé số Kiến Thiết\nVĩnh Long", "sec": 0.37}
{"image": "vg0_0143_s20261148.png", "engine": "vintern-1b-v3.5", "text": "NGÀY HỘI VIỆC LÀM\nTHANH NIÊN", "sec": 0.58}
{"image": "vg0_0144_s20261149.png", "engine": "vintern-1b-v3.5", "text": "Thời gian là vàng\nbác, đừng để\nlăng phí từng phút\ngiấy quý báu\ncủa cuộc đời.", "sec": 0.86}
{"image": "vg0_0145_s20261150.png", "engine": "vintern-1b-v3.5", "text": "Chúng tôi phục vụ phở bò, phở gà và bún chả Hà Nội từ sáu giờ sáng mỗi ngày.", "sec": 0.82}
{"image": "vg0_0146_s20261151.png", "engine": "vintern-1b-v3.5", "text": "Quý khách vui lòng xếp hàng trật tự và giữ khoảng cách an toàn với người phía trước.", "sec": 0.65}
{"image": "vg0_0147_s20261152.png", "engine": "vintern-1b-v3.5", "text": "Một cày lam chẳng non,\nba ty phum lai\nhên hòn cao.", "sec": 0.65}
{"image": "vg0_0148_s20261153.png", "engine": "vintern-1b-v3.5", "text": "Uống nước nhờ nguồn,\năn quả nhờ kẻ trồng cây,\nđố là dạo ly của người Việt.", "sec": 0.67}
{"image": "vg0_0149_s20261154.png", "engine": "vintern-1b-v3.5", "text": "Học sinh nghỉ hè từ ngày mười lăm tháng năm đến hết ngày ba mười mốt tháng tám.", "sec": 0.67}
{"image": "vg0_0150_s20261155.png", "engine": "vintern-1b-v3.5", "text": "Bánh mi nóng\ngiòn kẹp chả\nlụa, pa tề,\ndưa leo và\nrau thơm,\nchỉ hai mươi\nngún dồn.", "sec": 1.12}
{"image": "vg0_0151_s20261156.png", "engine": "vintern-1b-v3.5", "text": "Trên đường đời không có con đường nào trải đay hoa hồng, chỉ có sự kiên trì mới đưa ta tới đích.", "sec": 0.76}
{"image": "vg0_0152_s20261157.png", "engine": "vintern-1b-v3.5", "text": "Hãy bảo vệ môi trường bằng cách phân loại rác thải và hạn chế sử dụng túi ni lông.", "sec": 0.72}
{"image": "vg0_0153_s20261158.png", "engine": "vintern-1b-v3.5", "text": "Dêm nay trăng sáng vãng\nvặc trên dòng sông quê,\ntiêng ếch nhái rằm ran\nkháp cánh dòng.", "sec": 0.93}
{"image": "vg0_0154_s20261159.png", "engine": "vintern-1b-v3.5", "text": "Nhà hàng chúng\ntội nhận đặt\ntiệc cưới, sinh\nnhất, liên hoan\nvới thực đơn\nđa dạng và\ngiả cả hợp lý.", "sec": 1.04}
{"image": "vg0_0155_s20261160.png", "engine": "vintern-1b-v3.5", "text": "Gió mùa đông bắc\ntràn về, nhiệt độ ở\nvùng núi phía bắc\ncó nới giám xuống\ndưới mười độ.", "sec": 0.92}
{"image": "vg0_0156_s20261161.png", "engine": "vintern-1b-v3.5", "text": "Lễ hội hoa đăng sẽ diễn ra vào tối thứ bảy tại quảng trường trung tâm thành phố.", "sec": 0.67}
{"image": "vg0_0157_s20261162.png", "engine": "vintern-1b-v3.5", "text": "Dọc một cuốn sách\nhay giống như trò chuyện\nvới những người bạn\nuyên bậc nhất của\nnhiều thế kỷ.", "sec": 0.84}
{"image": "vg0_0158_s20261163.png", "engine": "vintern-1b-v3.5", "text": "Phòng tập mở cửa từ năm giờ sáng đến mười giờ tối, kể cả ngày lễ và chủ nhật.", "sec": 0.65}
{"image": "vg0_0159_s20261164.png", "engine": "vintern-1b-v3.5", "text": "Cuộc thi vẽ tranh thiếu nhi với chủ đề quê hương em đẹp lắm nhận bài đến hết tháng mười.", "sec": 0.67}
{"image": "vg0_0160_s20261165.png", "engine": "vintern-1b-v3.5", "text": "Xin lỗi quý khách, cửa hàng tạm nghỉ để sửa chữa và sẽ mở cửa trở lại vào tuần sau.", "sec": 0.67}
{"image": "vg0_0161_s20261166.png", "engine": "vintern-1b-v3.5", "text": "Những cánh đồng lúa\nchín vàng óng trải dài tít\ntắp dưới bầu trời xanh\nngắt mùa thu.", "sec": 0.83}
{"image": "vg0_0162_s20261167.png", "engine": "vintern-1b-v3.5", "text": "Ký luật là cầu nối giữa mục tiêu và thành tựu, hãy bắt đầu ngay từ hôm nay.", "sec": 0.71}
{"image": "vg0_0163_s20261168.png", "engine": "vintern-1b-v3.5", "text": "Tiếng Việt giàu và đẹp, mỗi dấu thanh mang một sắc thái riêng không thể thay thế.", "sec": 0.67}
{"image": "vg0_0164_s20261169.png", "engine": "vintern-1b-v3.5", "text": "Cẩn thận khi qua đường,\nhãy quan sát kỹ hai bên và\nđi trên vách dành cho người\nđi bọ.", "sec": 0.88}
{"image": "vg0_0165_s20261170.png", "engine": "vintern-1b-v3.5", "text": "Bữa cơm gia đình\ndòn sơ nhưng ẩm\náp, có canh rau\nmuống, cá kho tộ\nvà dĩa dưa cà.", "sec": 1.04}
{"image": "vg0_0166_s20261171.png", "engine": "vintern-1b-v3.5", "text": "Thư viện nhận quyền góp sách cũ để gửi tặng các em học sinh vùng sâu vùng xa.", "sec": 0.62}
{"image": "vg0_0167_s20261172.png", "engine": "vintern-1b-v3.5", "text": "Mỗi sáng sờm, cụ già ngồi bên hiên nhà nhâm nhi chén trà nóng và đọc tờ báo cũ.", "sec": 0.76}
{"image": "vg0_0168_s20261173.png", "engine": "vintern-1b-v3.5", "text": "Chương trình khuyến mãi áp dụng cho đơn hàng trên năm thứ nhất đồng đến hết ngày chủ nhật.", "sec": 0.63}
{"image": "vg0_0169_s20261174.png", "engine": "vintern-1b-v3.5", "text": "Dội tinh nguyện\nxanh tổ chức dọn\nrác bãi biển Mỳ\nKhê vào sáng chú\nnhật hăng tuần.", "sec": 0.89}
{"image": "vg0_0170_s20261175.png", "engine": "vintern-1b-v3.5", "text": "Mưa rơi lất phất trên\nmái ngói rêu phong\ncủa ngôi chùa cổ bên\nbờ hồ.", "sec": 0.81}
{"image": "vg0_0171_s20261176.png", "engine": "vintern-1b-v3.5", "text": "Đừng ngại thất bại, vì mỗi lần vấp ngã là một bài học quý giá cho chặng đường phía trước.", "sec": 0.74}
{"image": "vg0_0172_s20261177.png", "engine": "vintern-1b-v3.5", "text": "Hội thảo khoa học về trí tuệ nhân tạo và ứng dụng trọng giáo dục sẽ khai mạc lúc tám giờ sáng.", "sec": 0.82}
{"image": "vg0_0173_s20261178.png", "engine": "vintern-1b-v3.5", "text": "Ông bà ta thường\ndặn con cháu phải biết\nkính sến ngưỡng dưới\nvà sống chan hòa với\nxóm giêng.", "sec": 0.96}
{"image": "vg0_0174_s20261179.png", "engine": "vintern-1b-v3.5", "text": "Tàu hỏa Xuyến Việt dừng ở ga Huế khoảng mười làm phút để hành khách lên xuống.", "sec": 0.68}
{"image": "vg0_0175_s20261180.png", "engine": "vintern-1b-v3.5", "text": "Bản đồ du lịch gồm vịnh Hạ Long, phố cổ Hội An, cổ đồ Huế và đồng bằng song Cửu Long.", "sec": 0.82}
{"image": "vg0_0176_s20261181.png", "engine": "vintern-1b-v3.5", "text": "Ngày mai trời nắng ráo, thích hợp cho chuyến dắt ngoại của lớp mười hai A.", "sec": 0.64}
{"image": "vg0_0177_s20261182.png", "engine": "vintern-1b-v3.5", "text": "Anh ấy lặng lẻ ngồi đọc những bức thư cũ, đồi mắt đỏ hoe vi nhơ thương.", "sec": 0.69}
{"image": "vg0_0178_s20261183.png", "engine": "vintern-1b-v3.5", "text": "Giữ gìn sự trong sáng của tiếng Việt là trách nhiệm của mỗi người chúng ta.", "sec": 0.59}
{"image": "vg0_0179_s20261184.png", "engine": "vintern-1b-v3.5", "text": "Ngưỡng cửa đại học đã mở ra,\nchúc các em vững bước trên con đường tri thức.", "sec": 0.63}
