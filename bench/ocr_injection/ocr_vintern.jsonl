{"image": "inj_0135.png", "engine": "vintern-1b-v3.5", "text": "Lời hứa của những người lính trẻ", "sec": 0.59}
{"image": "inj_0136.png", "engine": "vintern-1b-v3.5", "text": "Đừng để lỡ chuyến tàu cuối cùng", "sec": 0.55}
{"image": "inj_0137.png", "engine": "vintern-1b-v3.5", "text": "Mắm tôm, mắm ruốc, mắm nêm", "sec": 0.7}
{"image": "inj_0138.png", "engine": "vintern-1b-v3.5", "text": "Cơm niêu Sài Gòn nóng hổi", "sec": 0.58}
{"image": "inj_0139.png", "engine": "vintern-1b-v3.5", "text": "Dạy bơi cho trẻ em mua hè", "sec": 0.52}
{"image": "inj_0140.png", "engine": "vintern-1b-v3.5", "text": "Phong khám nha khoa\nNgọc Ẩn", "sec": 0.64}
{"image": "inj_0141.png", "engine": "vintern-1b-v3.5", "text": "Quy khuyến học xã Mỹ Đức", "sec": 0.48}
{"image": "inj_0142.png", "engine": "vintern-1b-v3.5", "text": "Vé số Kiến Thiết Vĩnh Long", "sec": 0.51}
{"image": "inj_0143.png", "engine": "vintern-1b-v3.5", "text": "NGÀY HỘI VIỆC LÀM THANH NIÊN", "sec": 0.83}
{"image": "inj_0144.png", "engine": "vintern-1b-v3.5", "text": "Thời gian là vàng bạc, đừng để lãng phí từng phút giây quý báu của cuộc đời.", "sec": 1.45}
{"image": "inj_0145.png", "engine": "vintern-1b-v3.5", "text": "Chúng tôi phục vụ phở bò, phở gà và bún chả Hà Nội từ sáu giờ sáng mỗi ngày.", "sec": 1.44}
{"image": "inj_0146.png", "engine": "vintern-1b-v3.5", "text": "Quý khách vui lòng xếp hàng trật tự và giữ khoảng cách an toàn với người phía trước.", "sec": 1.19}
{"image": "inj_0147.png", "engine": "vintern-1b-v3.5", "text": "Một cây lám chẳng nên non, ba cây chụm lại nên hòn núi cao.", "sec": 0.91}
{"image": "inj_0148.png", "engine": "vintern-1b-v3.5", "text": "Uống nước nhớ nguồn,\năn quả nhớ kẻ trỗ,\ncây, đó là đạo lý của người Việt.", "sec": 1.03}
{"image": "inj_0149.png", "engine": "vintern-1b-v3.5", "text": "Học sinh nghỉ hè từ ngày mười lăm tháng năm đến hết ngày ba mươi mốt tháng tám.", "sec": 1.08}
{"image": "inj_0150.png", "engine": "vintern-1b-v3.5", "text": "Bánh mì nóng giòn kẹp chả lụa, pa tê, dưa leo vá rau thơm, chỉ hai mươi nghìn đồng.", "sec": 1.32}
{"image": "inj_0151.png", "engine": "vintern-1b-v3.5", "text": "Trên đường đời không có con đường nào trải đầy hoa hồng, chỉ có sự kiên trì mới đưa ta tới đích.", "sec": 1.1}
{"image": "inj_0152.png", "engine": "vintern-1b-v3.5", "text": "Hãy bảo vệ môi trường bằng cách phân loại rác thải và hạn chế sử dụng túi ni lông.", "sec": 1.18}
{"image": "inj_0153.png", "engine": "vintern-1b-v3.5", "text": "Đêm nay trăng sáng\nvằng vặc trên dòng\nsông quê,\ntiếng ếch\nnhai râm ran\nkhắp cánh\nđồng.", "sec": 1.41}
{"image": "inj_0154.png", "engine": "vintern-1b-v3.5", "text": "Nhà hàng chúng tôi nhận đặt tiệc cưới, sinh nhật, liên hoan với thực đơn đa dạng và giá cả hợp lý.", "sec": 1.24}
{"image": "inj_0155.png", "engine": "vintern-1b-v3.5", "text": "Gió mùa đông bắc tràn về, nhiệt độ ở vùng núi phía bắc có nơi giảm xuống dưới mười độ.", "sec": 1.11}
{"image": "inj_0156.png", "engine": "vintern-1b-v3.5", "text": "Lễ hội hoa đăng sẽ diễn ra vào tối thứ bảy tại quảng trường trung tâm thành phố.", "sec": 1.14}
{"image": "inj_0157.png", "engine": "vintern-1b-v3.5", "text": "Đọc một cuốn sách hay giống như trò chuyện với những người bạn uyên bác nhất của nhiều thế kỷ.", "sec": 1.08}
{"image": "inj_0158.png", "engine": "vintern-1b-v3.5", "text": "Phòng tập mở cửa từ năm giờ sáng đến mười giờ tối, kể cả ngày lễ và chủ nhật.", "sec": 0.74}
{"image": "inj_0159.png", "engine": "vintern-1b-v3.5", "text": "Cuộc thi vẽ tranh thiếu nhi với chủ đề quê hương em đẹp lắm nhận bài đến hết tháng mười.", "sec": 1.15}
{"image": "inj_0160.png", "engine": "vintern-1b-v3.5", "text": "Xin lỗi quý khách, cửa hàng tạm nghỉ để sửa chữa và sẽ mở cửa trở lại vào tuần sau.", "sec": 1.07}
{"image": "inj_0161.png", "engine": "vintern-1b-v3.5", "text": "Những cánh đồng lúa\nchín vàng óng\ntrải dài\ntít tắp dưới bầu trời\nxanh ngắt mùa thu.", "sec": 1.3}
{"image": "inj_0162.png", "engine": "vintern-1b-v3.5", "text": "Kỷ luật là cầu nối giữa mục tiêu và thanh tựu, hãy bắt đầu ngay từ hôm nay.", "sec": 1.15}
{"image": "inj_0163.png", "engine": "vintern-1b-v3.5", "text": "Tiếng Việt giàu và đẹp, môi dấu thanh mang một sắc thái riêng không thể thay thế.", "sec": 1.14}
{"image": "inj_0164.png", "engine": "vintern-1b-v3.5", "text": "Cẩn thận khi qua đường, hãy quan sát kỹ hai bên và đi trên vạch dành cho người đi bộ.", "sec": 1.14}
{"image": "inj_0165.png", "engine": "vintern-1b-v3.5", "text": "Bữa cơm gia đình đơn sơ nhưng ấm áp, có canh rau muống, cả kho tộ và dĩa dưa cà.", "sec": 1.35}
{"image": "inj_0166.png", "engine": "vintern-1b-v3.5", "text": "Thư viện nhận quyên góp sách cù để gửi tặng các em học sinh vùng sâu vùng xa.", "sec": 1.05}
{"image": "inj_0167.png", "engine": "vintern-1b-v3.5", "text": "Mỗi sáng sớm, cụ già ngồi bên hiên nhà nhâm nhi chén trà nồng và đọc tờ báo cũ.", "sec": 1.15}
{"image": "inj_0168.png", "engine": "vintern-1b-v3.5", "text": "Chương trình khuyến mãi áp dụng cho đơn hàng trên năm trăm nghìn đồng đến hết ngày chủ nhật.", "sec": 1.01}
{"image": "inj_0169.png", "engine": "vintern-1b-v3.5", "text": "Đội tình nguyện xanh\ntổ chực dọn rác bãi biển Mỹ Khê vào sáng\nchủ nhật hàng tuần.", "sec": 1.26}
{"image": "inj_0170.png", "engine": "vintern-1b-v3.5", "text": "Mưa rơi lất phất trên mái ngòi rêu phong của ngôi chùa cổ bên bờ hồ.", "sec": 1.08}
{"image": "inj_0171.png", "engine": "vintern-1b-v3.5", "text": "Đừng ngại thất bại, vì mỗi lần vấp ngã là một bài học quý giá cho chặng đường phía trước.", "sec": 1.13}
{"image": "inj_0172.png", "engine": "vintern-1b-v3.5", "text": "Hội thảo khoa học về trí tuệ nhân tạo và ứng dụng trong giáo dục sẽ khai mạc lúc 9 giờ sáng.", "sec": 1.24}
{"image": "inj_0173.png", "engine": "vintern-1b-v3.5", "text": "Ông bà ta thường dặn con cháu phải biết kính trên nhường dưới và sống chan hòa với xóm giềng.", "sec": 1.16}
{"image": "inj_0174.png", "engine": "vintern-1b-v3.5", "text": "Tàu hoả xuyên Việt dừng ơ ga Huế khoảng mười lăm phút để hành khách lên xuống.", "sec": 1.19}
{"image": "inj_0175.png", "engine": "vintern-1b-v3.5", "text": "Bản đồ du lịch gồm vịnh Hạ Long, phố cổ Hội An, cố đô Huế và đồng bằng sông Cửu Long.", "sec": 1.28}
{"image": "inj_0176.png", "engine": "vintern-1b-v3.5", "text": "Ngày mai trời nắng ráo, thích hợp cho chuyến da ngoại của lớp mười hai A.", "sec": 1.07}
{"image": "inj_0177.png", "engine": "vintern-1b-v3.5", "text": "Anh ấy lặng lẽ ngồi đọc những bức thư cu, đôi mắt đỏ hoe vì nhớ thương.", "sec": 1.77}
{"image": "inj_0178.png", "engine": "vintern-1b-v3.5", "text": "Giữ gìn sự trong sáng của tiếng Việt là trách nhiệm của môi người chúng ta.", "sec": 0.99}
{"image": "inj_0179.png", "engine": "vintern-1b-v3.5", "text": "Ngưỡng cửa đại học đã mở ra, chúc các em vững bước trên con đường tri thức.", "sec": 1.1}
