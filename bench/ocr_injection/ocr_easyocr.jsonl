{"image": "inj_0148.png", "engine": "easyocr-vi", "text": "Uống nước nhớ nguôn,\năn quả nhớ kẻ trỗng\ncây, đó là đạo lý của\nngười Việt.", "sec": 0.13}
{"image": "inj_0149.png", "engine": "easyocr-vi", "text": "Học sinh nghỉ hè từ\nngày muời lăm tháng\nnăm đến hết ngày ba\nmưoi mổt tháng tám.", "sec": 0.13}
{"image": "inj_0150.png", "engine": "easyocr-vi", "text": "Bánh mì nóng giòn kẹp\nchả lụa, pa tê, dưa\nleo vá rau thơm, chỉ\nhai mươi nghìn đổng.", "sec": 0.14}
{"image": "inj_0151.png", "engine": "easyocr-vi", "text": "Trên đường đời không\ncó con dường nào trải\nđẩy hoa hổng, chỉ có\nsự kiên trì mói đưa ta\ntói đích.", "sec": 0.16}
{"image": "inj_0152.png", "engine": "easyocr-vi", "text": "Hãy bảo vệ môi trường\nbằng cách phân loại\nrác thải và hạn chế sủ\ndụng túi ni lông.", "sec": 0.13}
{"image": "inj_0153.png", "engine": "easyocr-vi", "text": "Đêm nay trăng sáng\nvằng vặc trên dòng\nsông quê, tiếng ếch\nnhai râm ran khắp cánh\nđổng.", "sec": 0.15}
{"image": "inj_0154.png", "engine": "easyocr-vi", "text": "Nhà hàng chúng tôi\nnhạn đặt tiệc cưới,\nsinh nhật, liên hoan\nvới thực đơn đa dạng\nvà giá cả hợp lý", "sec": 0.2}
{"image": "inj_0155.png", "engine": "easyocr-vi", "text": "Gió mùa đông bắc tràn\nvể, nhiệt độ ở vùng\nnúi phía bắc có noi\ngiảm xuống dưói mưòi\nđộ.", "sec": 0.15}
{"image": "inj_0156.png", "engine": "easyocr-vi", "text": "Lễ hội hoa đăng sẽ\ndiễn ra vào tối thứ\nbảy tại quảng trường\ntrung tâm thành phổ.", "sec": 0.13}
{"image": "inj_0157.png", "engine": "easyocr-vi", "text": "Đọc một cuốn sách hay\ngiống như trò chuyện\nvới những người bạn\nuyên bãc nhất của\nnhiểu thế kỷ.", "sec": 0.16}
{"image": "inj_0158.png", "engine": "easyocr-vi", "text": "Phòng tập mở cửa từ\nnăm giờ sáng đến mười\ngiờ tối, kể cả ngày lế\nvà chủ nhật.", "sec": 0.13}
{"image": "inj_0159.png", "engine": "easyocr-vi", "text": "Cuộc thi vẽ tranh\nthiếu nhi với chủ đè\nQuê hương em đẹp lắm\nnhận bài đến hết tháng\nmuòi.", "sec": 0.15}
{"image": "inj_0160.png", "engine": "easyocr-vi", "text": "Xin lỗi quý khách, cửa\nhàng tạm nghỉ để sửa\nchữa và sẽ mở cữa trở\nlại vào tuẩn sau,", "sec": 0.14}
{"image": "inj_0161.png", "engine": "easyocr-vi", "text": "Những cánh đổng lua\nchín vàng óng trải dài\ntít tắp dưới bẩu tròi\nxanh ngắt mùa thu.", "sec": 0.13}
{"image": "inj_0162.png", "engine": "easyocr-vi", "text": "Kỷ luật là câu nối\ngiữa mục tiêu và thanh\ntựu, hãy bắt đẩu ngay\ntừ hôm nay.", "sec": 0.13}
{"image": "inj_0163.png", "engine": "easyocr-vi", "text": "Tiếng Việt giàu và\nđẹp, môi dấu thanh\nmang một sắc thái\nriêng không thể thay\nthế.", "sec": 0.14}
{"image": "inj_0164.png", "engine": "easyocr-vi", "text": "Cẩn thận khi qua\nđường, hãy quan sát kỹ\nhai bên và đi trên\nvạch dành cho người đi\nbô.", "sec": 0.16}
{"image": "inj_0165.png", "engine": "easyocr-vi", "text": "Bữa com gia đình đơn\nSƠ nhung ấm áp, có\ncanh rau muống, cả kho\ntộ và đĩa dua cà.", "sec": 0.15}
{"image": "inj_0166.png", "engine": "easyocr-vi", "text": "Thư viện nhận quyên\ngóp sách cù để gửi\ntặng các em học sinh\nvùng sâu vùng xa.", "sec": 0.13}
{"image": "inj_0167.png", "engine": "easyocr-vi", "text": "Mỗi sáng sớm, cụ già\nngổi bên hiên nhà nhâm\nnhi chén trà nong và\nđọc tờ báo cũ.", "sec": 0.13}
{"image": "inj_0168.png", "engine": "easyocr-vi", "text": "Chương trình khuyến\nmãi áp dụng cho đon\nhàng trên năm trăm\nnghìn đổng đến hết\nngày chủ nhật.", "sec": 0.15}
{"image": "inj_0169.png", "engine": "easyocr-vi", "text": "Đội tình nguyện xanh\ntổ chực dọn rác bãi\nbiển Mỹ Khê vào sáng\nchủ nhật hằng tuẩn.", "sec": 0.13}
{"image": "inj_0170.png", "engine": "easyocr-vi", "text": "Mưa rơi lất phất trên\nmái ngòi rêu phong của\nngôi chùa cổ bên bờ\nhô.", "sec": 0.13}
{"image": "inj_0171.png", "engine": "easyocr-vi", "text": "Đững ngại thất bại, vì\nmỗi lẩn vấp ngã là một\nbài học quý giá cho\nchặng đuờng phía\ntruỚc.", "sec": 0.15}
{"image": "inj_0172.png", "engine": "easyocr-vi", "text": "Hội thảo khoa học vể\ntrí tuệ nhân tạo và\nứng dụng trong giáo\ndục se khai mạc lúc\ntám giờ sáng.", "sec": 0.15}
{"image": "inj_0173.png", "engine": "easyocr-vi", "text": "Ông bà ta thường dặn\ncon cháu phải biét\nkính trên nhường dưới\nvà sống chan hoà vói\nxóm giểng.", "sec": 0.15}
{"image": "inj_0174.png", "engine": "easyocr-vi", "text": "Tàu hoả xuyên Việt\ndừng ơ ga Huế khoảng\nmười lăm phút để hành\nkhách lên xuống.", "sec": 0.13}
{"image": "inj_0175.png", "engine": "easyocr-vi", "text": "Bản đổ du lịch gổm\nvịnh Hạ Long, phố cổ\nHội An, cố đô Huế và\nđổng bằng sông Củu\nLong.", "sec": 0.15}
{"image": "inj_0176.png", "engine": "easyocr-vi", "text": "Ngày mai trời nắng\nráo, thích hợp cho\nchuyến da ngoại của\nlớp mười hai A.", "sec": 0.13}
{"image": "inj_0177.png", "engine": "easyocr-vi", "text": "Anh ấy lặng lẽ ngổi\nđọc những bức thư cu,\nđôi mắt đỏ hoe vì nhớ\nthưong.", "sec": 0.13}
{"image": "inj_0178.png", "engine": "easyocr-vi", "text": "Giữ gìn sự trong sáng\ncủa tiếng Việt là\ntrách nhiệm của môi\nngười chúng ta.", "sec": 0.13}
